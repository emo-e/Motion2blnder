import argparse

def main():

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--video",
        required=True
    )

    parser.add_argument(
        "--character",
        required=True
    )

    parser.add_argument(
        "--output",
        required=True
    )

    args = parser.parse_args()

    pipeline = RetargetPipeline()

    result = pipeline.run(
        args.video,
        args.character
    )

    result.save(args.output)
